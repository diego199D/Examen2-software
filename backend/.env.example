DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/diagramador_uml_db
PROJECT_NAME=Diagramador UML
# Clave para firmar los JWT. Genera una aleatoria, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Google Gemini (Google AI Studio): comandos de texto/voz, reconocimiento por
# foto y el agente Senior del chat grupal. La key vive SOLO en el backend.
# Conseguí la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-api-key-de-gemini
# Modelo principal (texto + tool calling).
GEMINI_MODEL=gemini-3.5-flash
# Modelo para importar diagramas desde imagen (puede ser el mismo).
GEMINI_VISION_MODEL=gemini-3.5-flash
# Respaldos en orden, separados por coma (cada modelo tiene su propia cuota).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
#venv\Scripts\activate
#uvicorn app.main:app --reload

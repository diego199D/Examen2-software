# Configuración de PRODUCCIÓN (docker-compose.yml). En el servidor:
#   cp .env.produccion.example .env
# y completar los valores. El .env real NUNCA se sube a git (ya está en
# .gitignore). Ver DESPLIEGUE.md.

# Nombre con el que se entra al sitio. Sin dominio propio, usar sslip.io con
# la IP elástica del servidor escrita con guiones:
#   IP 54.12.3.4  ->  DOMINIO=54-12-3-4.sslip.io
# Tiene que ser un nombre (no la IP sola) para que Caddy pueda sacar el
# certificado HTTPS, y HTTPS es obligatorio para el micrófono (comandos de voz).
DOMINIO=54-12-3-4.sslip.io

# Base de datos (contenedor "db", no expuesto a internet).
POSTGRES_USER=diagramador
# Contraseña larga y aleatoria, p. ej.: openssl rand -hex 24
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga
POSTGRES_DB=diagramador_uml_db

# Clave para firmar los tokens de sesión (JWT). Distinta a la de desarrollo:
#   openssl rand -base64 48
SECRET_KEY=cambiar-por-una-clave-aleatoria-larga
# Duración de la sesión en minutos (1440 = 24 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini (Google AI Studio): comandos de texto/voz, reconocimiento por
# foto y el agente Senior del chat grupal. La key vive SOLO en el backend.
# Conseguí la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-api-key-de-gemini
# Modelo principal (texto + tool calling).
GEMINI_MODEL=gemini-3.5-flash
# Modelo para importar diagramas desde imagen (puede ser el mismo).
GEMINI_VISION_MODEL=gemini-3.5-flash
# Respaldos en orden, separados por coma (cada modelo tiene su propia cuota).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
